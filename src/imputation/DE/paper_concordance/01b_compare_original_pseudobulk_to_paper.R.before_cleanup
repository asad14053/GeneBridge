#!/usr/bin/env Rscript

suppressPackageStartupMessages({
    library(SingleCellExperiment)
    library(SpatialExperiment)
    library(SummarizedExperiment)
    library(S4Vectors)
})

ROOT <- "/beegfs/labs/hulab/projects/mjabin/GeneBridge"

PAPER_RDS <- file.path(
    ROOT,
    "data/reference/paper_xenium",
    "spe_pseudo_donor_domain_spaTransfer_k50_smoothed_predictions.rds"
)

OUR_COUNTS <- file.path(
    ROOT,
    "outputs/imputation_full/DE/paper_concordance",
    "original_layer_pseudobulk",
    "original_xenium_300gene_donor_layer_pseudobulk_counts.csv.gz"
)

OUR_META <- file.path(
    ROOT,
    "outputs/imputation_full/DE/paper_concordance",
    "original_layer_pseudobulk",
    "original_xenium_300gene_donor_layer_pseudobulk_metadata.csv"
)



ENVI_OOF300_COUNTS <- file.path(
    ROOT,
    "outputs/imputation_full/DE/paper_concordance",
    "envi_layer_pseudobulk",
    "ENVI_measured300_donor_layer_pseudobulk.csv.gz"
)

ENVI_OOF300_META <- file.path(
    ROOT,
    "outputs/imputation_full/DE/paper_concordance",
    "envi_layer_pseudobulk",
    "ENVI_donor_layer_pseudobulk_metadata.csv"
)

OUT <- file.path(
    ROOT,
    "outputs/imputation_full/DE/paper_concordance",
    "original_layer_pseudobulk",
    "paper_raw_comparison"
)

dir.create(
    OUT,
    recursive = TRUE,
    showWarnings = FALSE
)


section <- function(title) {
    cat("\n", strrep("=", 100), "\n", sep = "")
    cat(title, "\n")
    cat(strrep("=", 100), "\n", sep = "")
}


section("COMPARE PAPER vs GENEBRIDGE RAW DONOR × DOMAIN PSEUDOBULK")


# =============================================================================
# Check files
# =============================================================================

for (f in c(
    PAPER_RDS,
    OUR_COUNTS,
    OUR_META,
    ENVI_OOF300_COUNTS,
    ENVI_OOF300_META
)) {
    if (!file.exists(f)) {
        stop("Missing file: ", f)
    }
}


cat("Paper RDS:\n", PAPER_RDS, "\n\n", sep = "")
cat("Our counts:\n", OUR_COUNTS, "\n\n", sep = "")
cat("Our metadata:\n", OUR_META, "\n", sep = "")


# =============================================================================
# Load paper pseudobulk
# =============================================================================

section("LOAD PAPER PSEUDOBULK")

paper <- readRDS(PAPER_RDS)

cat("Paper object class:\n")
print(class(paper))

cat("\nPaper dimensions:\n")
print(dim(paper))

paper_counts <- as.matrix(
    SummarizedExperiment::assay(
        paper,
        "counts"
    )
)

paper_meta <- as.data.frame(
    SummarizedExperiment::colData(
        paper
    )
)

paper_gene_meta <- as.data.frame(
    SummarizedExperiment::rowData(
        paper
    )
)


cat(
    "\nPaper raw count matrix:",
    nrow(paper_counts),
    "genes x",
    ncol(paper_counts),
    "pseudobulks\n"
)

cat("\nPaper colData columns:\n")
print(colnames(paper_meta))

cat("\nPaper rowData columns:\n")
print(colnames(paper_gene_meta))


# =============================================================================
# Load our pseudobulk
# =============================================================================

section("LOAD GENEBRIDGE PSEUDOBULK")

ours <- read.csv(
    OUR_COUNTS,
    row.names = 1,
    check.names = FALSE
)

our_meta <- read.csv(
    OUR_META,
    stringsAsFactors = FALSE,
    check.names = FALSE
)


cat(
    "Our raw count matrix:",
    nrow(ours),
    "pseudobulks x",
    ncol(ours),
    "genes\n"
)

cat(
    "Our metadata:",
    nrow(our_meta),
    "rows\n"
)


if (!"pseudobulk_id" %in% colnames(our_meta)) {
    stop("Our metadata lacks pseudobulk_id.")
}

if (!identical(
    rownames(ours),
    our_meta$pseudobulk_id
)) {
    stop(
        "Our count matrix rows do not match metadata pseudobulk_id order."
    )
}


# =============================================================================
# Required metadata
# =============================================================================

paper_required <- c(
    "BrNum",
    "predictions_smooth"
)

our_required <- c(
    "BrNum",
    "predictions_smooth",
    "layer_annotation",
    "n_cells"
)


missing_paper <- setdiff(
    paper_required,
    colnames(paper_meta)
)

missing_ours <- setdiff(
    our_required,
    colnames(our_meta)
)


if (length(missing_paper) > 0) {
    stop(
        "Paper metadata missing: ",
        paste(missing_paper, collapse = ", ")
    )
}

if (length(missing_ours) > 0) {
    stop(
        "Our metadata missing: ",
        paste(missing_ours, collapse = ", ")
    )
}


# =============================================================================
# Find paper gene symbols
# =============================================================================

section("ALIGN 300 GENES")

gene_candidates <- c(
    "Symbol",
    "symbol",
    "gene",
    "gene_name"
)

gene_col <- gene_candidates[
    gene_candidates %in% colnames(paper_gene_meta)
]


if (length(gene_col) > 0) {

    gene_col <- gene_col[1]

    paper_genes <- as.character(
        paper_gene_meta[[gene_col]]
    )

    cat(
        "Using paper rowData gene column:",
        gene_col,
        "\n"
    )

} else {

    paper_genes <- rownames(paper)

    cat(
        "No symbol column identified; using paper rownames.\n"
    )
}


if (anyDuplicated(paper_genes)) {
    stop("Duplicated paper gene symbols detected.")
}

if (anyDuplicated(colnames(ours))) {
    stop("Duplicated GeneBridge gene names detected.")
}


our_genes <- colnames(ours)

shared_genes <- intersect(
    our_genes,
    paper_genes
)


cat("Paper genes     :", length(paper_genes), "\n")
cat("GeneBridge genes:", length(our_genes), "\n")
cat("Shared genes    :", length(shared_genes), "\n")


paper_only_genes <- setdiff(
    paper_genes,
    our_genes
)

our_only_genes <- setdiff(
    our_genes,
    paper_genes
)


cat("Paper-only genes:", length(paper_only_genes), "\n")
cat("Our-only genes  :", length(our_only_genes), "\n")


if (length(shared_genes) != 300) {

    if (length(paper_only_genes) > 0) {
        cat(
            "\nPaper-only genes:\n",
            paste(paper_only_genes, collapse = ", "),
            "\n"
        )
    }

    if (length(our_only_genes) > 0) {
        cat(
            "\nOur-only genes:\n",
            paste(our_only_genes, collapse = ", "),
            "\n"
        )
    }

    stop("Expected exactly 300 shared genes.")
}


# Align paper genes into exactly our gene order.

paper_gene_index <- match(
    our_genes,
    paper_genes
)

stopifnot(
    !any(is.na(paper_gene_index))
)


paper_counts <- paper_counts[
    paper_gene_index,
    ,
    drop = FALSE
]

rownames(paper_counts) <- our_genes


# =============================================================================
# Subset paper to GeneBridge 23 donors
# =============================================================================

section("SUBSET PAPER N24 → GENEBRIDGE N23")

our_donors <- unique(
    as.character(
        our_meta$BrNum
    )
)

paper_donors_all <- unique(
    as.character(
        paper_meta$BrNum
    )
)


cat("Paper donors total     :", length(paper_donors_all), "\n")
cat("GeneBridge donors      :", length(our_donors), "\n")


paper_only_donors <- setdiff(
    paper_donors_all,
    our_donors
)

cat(
    "Paper donors excluded from N23 comparison:",
    paste(paper_only_donors, collapse = ", "),
    "\n"
)


keep_paper_samples <- (
    as.character(paper_meta$BrNum)
    %in%
    our_donors
)

paper_counts_23 <- paper_counts[
    ,
    keep_paper_samples,
    drop = FALSE
]

paper_meta_23 <- paper_meta[
    keep_paper_samples,
    ,
    drop = FALSE
]


cat(
    "Paper pseudobulks after N23 subset:",
    ncol(paper_counts_23),
    "\n"
)

cat(
    "Our pseudobulks:",
    nrow(ours),
    "\n"
)


# =============================================================================
# Create canonical sample keys
# =============================================================================

section("ALIGN DONOR × SPATIAL DOMAIN")


paper_key <- paste(
    as.character(paper_meta_23$BrNum),
    as.character(paper_meta_23$predictions_smooth),
    sep = "::"
)

our_key <- paste(
    as.character(our_meta$BrNum),
    as.character(our_meta$predictions_smooth),
    sep = "::"
)


if (anyDuplicated(paper_key)) {
    stop("Duplicated paper donor-domain keys.")
}

if (anyDuplicated(our_key)) {
    stop("Duplicated GeneBridge donor-domain keys.")
}


paper_only_keys <- setdiff(
    paper_key,
    our_key
)

our_only_keys <- setdiff(
    our_key,
    paper_key
)


cat("Paper N23 donor-domain keys:", length(paper_key), "\n")
cat("Our donor-domain keys      :", length(our_key), "\n")

cat("Paper-only keys:", length(paper_only_keys), "\n")
cat("Our-only keys  :", length(our_only_keys), "\n")


if (length(paper_only_keys) > 0) {
    cat(
        "\nPaper-only sample keys:\n",
        paste(paper_only_keys, collapse = "\n"),
        "\n"
    )
}

if (length(our_only_keys) > 0) {
    cat(
        "\nOur-only sample keys:\n",
        paste(our_only_keys, collapse = "\n"),
        "\n"
    )
}


if (
    length(paper_only_keys) > 0 ||
    length(our_only_keys) > 0
) {
    stop("Donor-domain sample universe does not match.")
}


# Reorder paper samples to exact GeneBridge order.

paper_sample_index <- match(
    our_key,
    paper_key
)

stopifnot(
    !any(is.na(paper_sample_index))
)


paper_counts_aligned <- paper_counts_23[
    ,
    paper_sample_index,
    drop = FALSE
]

paper_meta_aligned <- paper_meta_23[
    paper_sample_index,
    ,
    drop = FALSE
]


# Convert paper to samples × genes, exactly like ours.

paper_matrix <- t(
    paper_counts_aligned
)

colnames(paper_matrix) <- our_genes
rownames(paper_matrix) <- rownames(ours)


our_matrix <- as.matrix(
    ours[
        ,
        our_genes,
        drop = FALSE
    ]
)


storage.mode(paper_matrix) <- "double"
storage.mode(our_matrix) <- "double"


stopifnot(
    identical(
        dim(paper_matrix),
        dim(our_matrix)
    )
)


# =============================================================================
# Compare spatial labels
# =============================================================================

section("COMPARE SPATIAL LABELS")

label_compare <- data.frame(
    pseudobulk_id = our_meta$pseudobulk_id,
    BrNum = our_meta$BrNum,
    paper_predictions_smooth =
        as.character(
            paper_meta_aligned$predictions_smooth
        ),
    our_predictions_smooth =
        as.character(
            our_meta$predictions_smooth
        ),
    our_layer_annotation =
        as.character(
            our_meta$layer_annotation
        ),
    stringsAsFactors = FALSE
)


label_compare$prediction_match <- (
    label_compare$paper_predictions_smooth
    ==
    label_compare$our_predictions_smooth
)


cat(
    "Spatial-domain labels identical:",
    all(label_compare$prediction_match),
    "\n"
)


# =============================================================================
# Compare number of cells
# =============================================================================

section("COMPARE NUMBER OF CELLS PER PSEUDOBULK")

paper_ncells_col <- NULL

for (candidate in c("ncells", "n_cells")) {

    if (candidate %in% colnames(paper_meta_aligned)) {
        paper_ncells_col <- candidate
        break
    }
}


if (!is.null(paper_ncells_col)) {

    paper_ncells <- as.numeric(
        paper_meta_aligned[[paper_ncells_col]]
    )

    our_ncells <- as.numeric(
        our_meta$n_cells
    )

    ncells_match <- (
        paper_ncells == our_ncells
    )

    ncells_compare <- data.frame(
        pseudobulk_id =
            our_meta$pseudobulk_id,
        BrNum =
            our_meta$BrNum,
        predictions_smooth =
            our_meta$predictions_smooth,
        layer_annotation =
            our_meta$layer_annotation,
        paper_ncells =
            paper_ncells,
        our_ncells =
            our_ncells,
        difference =
            our_ncells - paper_ncells,
        exact_match =
            ncells_match
    )


    cat(
        "Paper ncells column:",
        paper_ncells_col,
        "\n"
    )

    cat(
        "Exact n_cells matches:",
        sum(ncells_match),
        "/",
        length(ncells_match),
        "\n"
    )

    cat(
        "All donor-domain n_cells identical:",
        all(ncells_match),
        "\n"
    )


    write.csv(
        ncells_compare,
        file.path(
            OUT,
            "paper_vs_genebridge_ncells.csv"
        ),
        row.names = FALSE
    )

} else {

    warning(
        "Could not find ncells column in paper pseudobulk metadata."
    )

    ncells_match <- rep(
        NA,
        nrow(ours)
    )
}


# =============================================================================
# RAW COUNT COMPARISON
# =============================================================================

section("COMPARE RAW PSEUDOBULK COUNTS")


difference <- (
    our_matrix
    -
    paper_matrix
)


exact_matrix <- (
    difference == 0
)


n_total <- length(
    difference
)

n_exact <- sum(
    exact_matrix
)

n_mismatch <- n_total - n_exact


cat(
    "Entries compared:",
    n_total,
    "\n"
)

cat(
    "Exact entries:",
    n_exact,
    "\n"
)

cat(
    "Mismatched entries:",
    n_mismatch,
    "\n"
)

cat(
    "Exact fraction:",
    sprintf(
        "%.8f",
        n_exact / n_total
    ),
    "\n"
)

cat(
    "Maximum absolute count difference:",
    max(abs(difference)),
    "\n"
)

cat(
    "Total absolute count difference:",
    sum(abs(difference)),
    "\n"
)


raw_counts_identical <- (
    n_mismatch == 0
)


cat(
    "\nRAW COUNTS IDENTICAL:",
    raw_counts_identical,
    "\n"
)


# =============================================================================
# Per-pseudobulk diagnostics
# =============================================================================

paper_totals <- rowSums(
    paper_matrix
)

our_totals <- rowSums(
    our_matrix
)


sample_summary <- data.frame(
    pseudobulk_id =
        our_meta$pseudobulk_id,

    BrNum =
        our_meta$BrNum,

    predictions_smooth =
        our_meta$predictions_smooth,

    layer_annotation =
        our_meta$layer_annotation,

    paper_total_counts =
        paper_totals,

    our_total_counts =
        our_totals,

    total_difference =
        our_totals - paper_totals,

    n_gene_mismatches =
        rowSums(!exact_matrix),

    max_abs_gene_difference =
        apply(
            abs(difference),
            1,
            max
        ),

    exact_match =
        rowSums(!exact_matrix) == 0,

    stringsAsFactors = FALSE
)


write.csv(
    sample_summary,
    file.path(
        OUT,
        "paper_vs_genebridge_per_pseudobulk_summary.csv"
    ),
    row.names = FALSE
)


# =============================================================================
# Per-gene diagnostics
# =============================================================================

gene_summary <- data.frame(
    gene =
        our_genes,

    paper_total =
        colSums(paper_matrix),

    our_total =
        colSums(our_matrix),

    total_difference =
        colSums(our_matrix)
        -
        colSums(paper_matrix),

    n_sample_mismatches =
        colSums(!exact_matrix),

    max_abs_sample_difference =
        apply(
            abs(difference),
            2,
            max
        ),

    exact_match =
        colSums(!exact_matrix) == 0,

    stringsAsFactors = FALSE
)


write.csv(
    gene_summary,
    file.path(
        OUT,
        "paper_vs_genebridge_per_gene_summary.csv"
    ),
    row.names = FALSE
)


# =============================================================================
# Long mismatch table
# =============================================================================

if (n_mismatch > 0) {

    idx <- which(
        !exact_matrix,
        arr.ind = TRUE
    )


    mismatch_table <- data.frame(
        pseudobulk_id =
            rownames(our_matrix)[
                idx[, 1]
            ],

        gene =
            colnames(our_matrix)[
                idx[, 2]
            ],

        paper_count =
            paper_matrix[idx],

        our_count =
            our_matrix[idx],

        difference =
            difference[idx],

        stringsAsFactors = FALSE
    )


    write.csv(
        mismatch_table,
        file.path(
            OUT,
            "paper_vs_genebridge_raw_count_mismatches.csv.gz"
        ),
        row.names = FALSE
    )

}


# =============================================================================
# Correlation for diagnostic purposes
# =============================================================================

flat_paper <- as.vector(
    paper_matrix
)

flat_ours <- as.vector(
    our_matrix
)


pearson_counts <- suppressWarnings(
    cor(
        flat_paper,
        flat_ours,
        method = "pearson"
    )
)


spearman_counts <- suppressWarnings(
    cor(
        flat_paper,
        flat_ours,
        method = "spearman"
    )
)




# =============================================================================
# PAPER vs ORIGINAL vs ENVI OOF-IMPUTED 300
# DONOR × DOMAIN PSEUDOBULK COMPARISON
# =============================================================================

section(
    "PAPER vs ORIGINAL vs ENVI OOF-IMPUTED 300 — DONOR × DOMAIN"
)


# -----------------------------------------------------------------------------
# Load ENVI OOF-imputed 300-gene pseudobulk
# -----------------------------------------------------------------------------

envi_oof300 <- read.csv(
    ENVI_OOF300_COUNTS,
    row.names = 1,
    check.names = FALSE
)

envi_oof300_meta <- read.csv(
    ENVI_OOF300_META,
    stringsAsFactors = FALSE,
    check.names = FALSE
)


cat(
    "ENVI OOF-300 matrix:",
    nrow(envi_oof300),
    "pseudobulks x",
    ncol(envi_oof300),
    "genes\n"
)

cat(
    "ENVI OOF-300 metadata:",
    nrow(envi_oof300_meta),
    "rows\n"
)


if (
    nrow(envi_oof300) != 161 ||
    ncol(envi_oof300) != 300
) {
    stop(
        "Unexpected ENVI OOF-300 dimensions: ",
        nrow(envi_oof300),
        " x ",
        ncol(envi_oof300)
    )
}


# -----------------------------------------------------------------------------
# Validate gene universe
# -----------------------------------------------------------------------------

if (
    !setequal(
        colnames(envi_oof300),
        our_genes
    )
) {

    stop(
        "ENVI OOF-imputed 300 gene universe does not match ",
        "the original Xenium 300-gene panel."
    )
}


# Reorder ENVI genes to exact original Xenium gene order.

envi_oof300 <- envi_oof300[
    ,
    our_genes,
    drop = FALSE
]


# -----------------------------------------------------------------------------
# Align donor-domain pseudobulks
# -----------------------------------------------------------------------------

if (
    "pseudobulk_id"
    %in%
    colnames(envi_oof300_meta)
) {

    envi_pb_ids <- as.character(
        envi_oof300_meta$pseudobulk_id
    )

} else {

    if (
        !all(
            c(
                "BrNum",
                "predictions_smooth"
            )
            %in%
            colnames(envi_oof300_meta)
        )
    ) {
        stop(
            "Cannot identify donor-domain IDs ",
            "in ENVI OOF-300 metadata."
        )
    }


    envi_pb_ids <- paste(
        envi_oof300_meta$BrNum,
        envi_oof300_meta$predictions_smooth,
        sep = "::"
    )
}


our_domain_keys <- paste(
    our_meta$BrNum,
    our_meta$predictions_smooth,
    sep = "::"
)


# Prefer explicit pseudobulk IDs if matrix rows contain them.

if (
    all(
        our_meta$pseudobulk_id
        %in%
        rownames(envi_oof300)
    )
) {

    envi_idx <- match(
        our_meta$pseudobulk_id,
        rownames(envi_oof300)
    )

} else {

    envi_idx <- match(
        our_domain_keys,
        envi_pb_ids
    )
}


if (any(is.na(envi_idx))) {

    stop(
        "Could not align every ENVI OOF-300 donor-domain pseudobulk."
    )
}


envi_oof300 <- envi_oof300[
    envi_idx,
    ,
    drop = FALSE
]


envi_oof300_matrix <- as.matrix(
    envi_oof300
)

storage.mode(
    envi_oof300_matrix
) <- "double"


if (
    !identical(
        dim(envi_oof300_matrix),
        dim(our_matrix)
    )
) {

    stop(
        "Original Xenium and ENVI OOF-300 matrices ",
        "have different dimensions."
    )
}


# -----------------------------------------------------------------------------
# Correlation helper
# -----------------------------------------------------------------------------

safe_cor <- function(
    x,
    y,
    method = "pearson"
) {

    if (
        length(unique(x)) < 2 ||
        length(unique(y)) < 2
    ) {
        return(NA_real_)
    }

    suppressWarnings(
        cor(
            x,
            y,
            method = method
        )
    )
}


# -----------------------------------------------------------------------------
# Per donor × domain summary
# -----------------------------------------------------------------------------

donor_domain_comparison <- data.frame(

    pseudobulk_id =
        our_meta$pseudobulk_id,

    BrNum =
        our_meta$BrNum,

    Dx =
        if (
            "Dx"
            %in%
            colnames(our_meta)
        ) {
            our_meta$Dx
        } else {
            NA
        },

    predictions_smooth =
        our_meta$predictions_smooth,

    layer_annotation =
        our_meta$layer_annotation,

    n_cells =
        our_meta$n_cells,

    paper_total_counts =
        rowSums(
            paper_matrix
        ),

    original_total_counts =
        rowSums(
            our_matrix
        ),

    envi_oof300_total =
        rowSums(
            envi_oof300_matrix
        ),

    paper_vs_original_total_difference =
        rowSums(
            our_matrix
        ) -
        rowSums(
            paper_matrix
        ),

    original_vs_envi_oof300_total_difference =
        rowSums(
            envi_oof300_matrix
        ) -
        rowSums(
            our_matrix
        ),

    paper_vs_original_n_exact_genes =
        rowSums(
            paper_matrix
            ==
            our_matrix
        ),

    original_vs_envi_oof300_n_exact_genes =
        rowSums(
            our_matrix
            ==
            envi_oof300_matrix
        ),

    paper_vs_original_n_mismatch_genes =
        rowSums(
            paper_matrix
            !=
            our_matrix
        ),

    original_vs_envi_oof300_n_mismatch_genes =
        rowSums(
            our_matrix
            !=
            envi_oof300_matrix
        ),

    paper_vs_original_max_abs_difference =
        apply(
            abs(
                paper_matrix
                -
                our_matrix
            ),
            1,
            max
        ),

    original_vs_envi_oof300_mean_abs_difference =
        rowMeans(
            abs(
                envi_oof300_matrix
                -
                our_matrix
            )
        ),

    original_vs_envi_oof300_rmse =
        sqrt(
            rowMeans(
                (
                    envi_oof300_matrix
                    -
                    our_matrix
                )^2
            )
        ),

    stringsAsFactors = FALSE
)


# -----------------------------------------------------------------------------
# Correlations across the 300 genes within each donor-domain
# -----------------------------------------------------------------------------

donor_domain_comparison$
    paper_vs_original_pearson <- vapply(

        seq_len(
            nrow(our_matrix)
        ),

        function(i) {

            safe_cor(
                paper_matrix[i, ],
                our_matrix[i, ],
                method = "pearson"
            )
        },

        numeric(1)
    )


donor_domain_comparison$
    original_vs_envi_oof300_pearson <- vapply(

        seq_len(
            nrow(our_matrix)
        ),

        function(i) {

            safe_cor(
                our_matrix[i, ],
                envi_oof300_matrix[i, ],
                method = "pearson"
